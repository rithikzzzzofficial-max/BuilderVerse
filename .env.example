# BuilderVerse environment variables
# Copy this file to `.env.local` and fill in the values you need.
# Never commit `.env.local` or real secrets to GitHub.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite database file (created automatically on first run).
# Leave empty to use the default: ./data/builderverse.db
DATABASE_PATH=

# ---------------------------------------------------------------------------
# App URL
# ---------------------------------------------------------------------------
# Absolute base URL used in password-reset emails. Defaults to
# http://localhost:3000 — set this when you deploy.
APP_URL=

# ---------------------------------------------------------------------------
# Builder AI (optional)
# ---------------------------------------------------------------------------
# BuilderVerse works fully without AI. When a key is provided, the
# Builder AI assistant becomes available.
# Any OpenAI-compatible chat completions endpoint is supported.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Email (optional, for password reset links)
# ---------------------------------------------------------------------------
# Without an email provider, password-reset links are shown on screen in
# development and logged on the server in production.
RESEND_API_KEY=
EMAIL_FROM=BuilderVerse <no-reply@builderverse.local>
